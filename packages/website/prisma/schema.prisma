// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String        @id
  pinLimit  Int           @default(1000)
  sizeLimit BigInt        @default(10737418240) // 10GB in bytes
  pinCount  Int           @default(0)
  size      BigInt        @default(0)
  clusters  UserCluster[]
  pins      Pin[]
  apiKeys   ApiKey[]
  wallets   UserWallet[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("users")
}

// Mirror of the Ethereum wallet addresses linked to a user's Privy account
// (lowercase). Used to associate paid (MPP/x402) pins with the payer's
// account. Seeded at first login, extended when a known Privy wallet pays.
model UserWallet {
  address   String   @id // lowercase 0x address
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("user_wallets")
}

model IpfsCluster {
  id          String        @id @default(cuid())
  name        String
  gatewayUrl  String
  apiUrl      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  apiKey      ApiKey[]
  userCluster UserCluster[]
  Pin         Pin[]

  @@unique([name])
  @@map("ipfs_clusters")
}

model UserCluster {
  userId      String
  clusterId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id])
  ipfsCluster IpfsCluster @relation(fields: [clusterId], references: [id])

  @@id([userId, clusterId])
  @@map("user_clusters")
}

model ApiKey {
  id            String      @id @default(cuid())
  name          String
  userId        String
  apiKey        String      @unique
  ipfsClusterId String      @default("default")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  user          User        @relation(fields: [userId], references: [id])
  ipfsCluster   IpfsCluster @relation(fields: [ipfsClusterId], references: [id])

  @@unique([name, userId])
  @@index([userId])
  @@map("api_keys")
}

model Pin {
  userId        String
  cid           String
  name          String?
  size          BigInt
  deletedAt     DateTime?
  ipfsClusterId String
  // Set on pins created through the paid (MPP/x402) keyless upload path
  payerAddress     String?
  paymentReference String? // settlement tx hash
  paymentNetwork   String? // e.g. 'base', 'base-sepolia'
  paymentAmount    String? // USDC display units, e.g. '0.01'
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id])
  ipfsCluster   IpfsCluster @relation(fields: [ipfsClusterId], references: [id])

  @@id([userId, cid])
  @@index([cid])
  @@map("pins")
}
