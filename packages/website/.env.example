# Local full stack: Next talks to ipfs-proxy (wrangler dev); worker proxies to cluster URL from DB (seed uses :5555).
IPFS_API_URL=http://127.0.0.1:8787

# Only if IPFS_API_URL points at a basic-auth cluster (e.g. Traefik) directly—not used when using the worker.
# IPFS_AUTH_USERNAME=user
# IPFS_AUTH_PASSWORD=your_cluster_upload_password

# Same Postgres as root docker-compose.dev.yml (pnpm dev:db)
DATABASE_URL="postgresql://bgipfs:bgipfs_dev@127.0.0.1:5432/bgipfs"

# Must match packages/ipfs-proxy/.dev.vars WORKER_AUTH_SECRET (worker calls /api/auth and /api/pin)
WORKER_AUTH_SECRET=dev-shared-secret

NEXT_PUBLIC_PRIVY_APP_ID="your-privy-app-id"
PRIVY_APP_SECRET=your_privy_app_secret
PRIVY_VERIFICATION_KEY=your-verification-key-from-dashboard

DEFAULT_PIN_LIMIT=1000
DEFAULT_SIZE_LIMIT=104857600
NEXT_PUBLIC_DEFAULT_CLUSTER_ID=community

# API key for keyless uploads from the site's demo/upload pages (a dedicated
# capped account). Without it, keyless demo uploads hit the worker unkeyed and
# are rejected once payments are enabled.
# DEMO_API_KEY=your_demo_account_api_key
