# Copy to .env.prod-debug.local (gitignored). Never commit real secrets.
# Run from repo root: pnpm dev:website:prod-debug
# Uses production DATABASE_URL / worker URL / Privy while Next runs locally. You can mutate prod data—use read-only or staging when possible. Do not run local ipfs-proxy unless you intend to.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
IPFS_API_URL=https://your-prod-worker.example.com
WORKER_AUTH_SECRET=your-prod-worker-auth-secret

NEXT_PUBLIC_PRIVY_APP_ID="your-prod-privy-app-id"
PRIVY_APP_SECRET=your_prod_privy_app_secret
PRIVY_VERIFICATION_KEY=your-prod-verification-key

DEFAULT_PIN_LIMIT=1000
DEFAULT_SIZE_LIMIT=104857600
NEXT_PUBLIC_DEFAULT_CLUSTER_ID=community
